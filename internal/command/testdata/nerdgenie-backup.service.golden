# Written by "nerdgenie install". Run "nerdgenie install" again to replace it, or
# "nerdgenie uninstall" to take it away.

[Unit]
Description=Nerd Genie nightly backup of the database, the vault, and the browser profile

[Service]
Type=oneshot
ExecStart=/home/tester/.nerdgenie/releases/current backup
Environment=NERDGENIE_HOME=/home/tester/.nerdgenie
