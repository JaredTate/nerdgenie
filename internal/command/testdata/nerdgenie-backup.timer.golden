# Written by "nerdgenie install". Run "nerdgenie install" again to replace it, or
# "nerdgenie uninstall" to take it away.

[Unit]
Description=Nerd Genie nightly backup

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=900
Persistent=true
Unit=nerdgenie-backup.service

[Install]
WantedBy=timers.target
