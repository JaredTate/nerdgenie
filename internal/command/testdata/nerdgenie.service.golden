# Written by "nerdgenie install". Run "nerdgenie install" again to replace it, or
# "nerdgenie uninstall" to take it away.

[Unit]
Description=Nerd Genie, an assistant that runs on your own computer
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/home/tester/.nerdgenie/releases/current serve
Environment=NERDGENIE_HOME=/home/tester/.nerdgenie
WatchdogSec=60
Restart=on-failure
RestartSec=5
SuccessExitStatus=75
RestartForceExitStatus=75
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
